#!/usr/bin/env python3
"""Update the pinned Raycast release from Raycast's official latest download redirect."""
import base64
import hashlib
import json
import os
from pathlib import Path
import re
import sys
import urllib.error
import urllib.request

SOURCE = Path(__file__).resolve().parent.parent / "nix" / "raycast-source.json"
# nixpkgs の raycast の updateScript と同じ入口。最新版の DMG へ 302 でリダイレクトされる。
LATEST = "https://x.raycast-releases.com/download?platform=macos&architecture=arm64"
DMG_URL = re.compile(
    r"https://x-r2\.raycast-releases\.com/Raycast_([0-9]+(?:\.[0-9]+){3})_[0-9a-f]+_arm64\.dmg"
)
USER_AGENT = "dotfiles-raycast-updater"


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def latest_url():
    opener = urllib.request.build_opener(NoRedirect)
    request = urllib.request.Request(LATEST, method="HEAD", headers={"User-Agent": USER_AGENT})
    try:
        opener.open(request, timeout=30)
    except urllib.error.HTTPError as exc:
        if exc.code in (301, 302, 303, 307, 308) and exc.headers.get("Location"):
            return exc.headers["Location"]
        raise
    raise ValueError("expected a redirect to the latest DMG")


def sha256_sri(url):
    digest = hashlib.sha256()
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(request, timeout=300) as response:
        while chunk := response.read(1 << 20):
            digest.update(chunk)
    return "sha256-" + base64.b64encode(digest.digest()).decode("ascii")


def version_tuple(version):
    return tuple(int(part) for part in version.split("."))


def main():
    current = json.loads(SOURCE.read_text())
    url = latest_url()
    match = DMG_URL.fullmatch(url)
    if not match:
        raise ValueError(f"unexpected download URL: {url!r}")
    version = match.group(1)
    if version_tuple(version) < version_tuple(current["version"]):
        raise ValueError(f"refusing to downgrade {current['version']} to {version}")
    if url == current["url"]:
        changed = False
    else:
        if version == current["version"]:
            raise ValueError("download URL changed for an existing version; investigate manually")
        updated = {"version": version, "url": url, "hash": sha256_sri(url)}
        SOURCE.write_text(json.dumps(updated, indent=2) + "\n")
        changed = True
    print(f"raycast: {current['version']} -> {version}" if changed else f"raycast {version} is up to date")
    if output := os.environ.get("GITHUB_OUTPUT"):
        with open(output, "a") as stream:
            stream.write(f"changed={'true' if changed else 'false'}\nbefore={current['version']}\nafter={version}\n")


if __name__ == "__main__":
    try:
        main()
    except (KeyError, ValueError, OSError) as exc:
        print(f"raycast update failed: {exc}", file=sys.stderr)
        sys.exit(1)
