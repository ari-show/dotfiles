#!/usr/bin/env perl
use strict;
use warnings;
use feature 'say';
use FindBin qw($RealBin);
use File::Copy qw(copy);
use File::Path qw(make_path);
use File::Temp qw(tempfile);
use JSON::PP;

$^O eq 'darwin' or die "Docker Desktop configuration is supported on macOS only\n";
my $pid = `/usr/bin/pgrep -x Docker`;
my $status = $? >> 8;
$status == 1 or die $status == 0 ? "Quit Docker Desktop before changing its Engine configuration\n" : "Failed to check Docker Desktop status\n";
my $home = $ENV{HOME} or die "HOME is not set\n";
my $dir = "$home/.docker";
my $target = "$dir/daemon.json";
-l $target and die "Refusing to replace symlink: $target\n";
my $json = JSON::PP->new->canonical->pretty;
sub read_json {
    my ($path) = @_;
    open my $fh, '<', $path or die "Cannot read $path: $!\n";
    local $/;
    my $value = $json->decode(<$fh>);
    close $fh or die "Cannot close $path: $!\n";
    ref($value) eq 'HASH' or die "$path must contain a JSON object\n";
    return $value;
}
sub merge {
    my ($target, $source) = @_;
    for my $key (keys %$source) {
        if (ref($source->{$key}) eq 'HASH') {
            $target->{$key} //= {};
            ref($target->{$key}) eq 'HASH' or die "$key is not an object\n";
            merge($target->{$key}, $source->{$key});
        } else {
            $target->{$key} = $source->{$key};
        }
    }
}
my $managed = read_json("$RealBin/../config/mac/docker-engine.json");
my $data = -e $target ? read_json($target) : {};
my $before = $json->encode($data);
merge($data, $managed);
my $after = $json->encode($data);
if ($before eq $after) { say 'Docker Engine settings are already up to date'; exit 0; }
make_path($dir);
if (-e $target) {
    my ($backup_fh, $backup) = tempfile('daemon.json.backup-XXXXXXXX', DIR => $dir, UNLINK => 0);
    close $backup_fh or die "Cannot close backup: $!\n";
    copy($target, $backup) or die "Cannot back up $target: $!\n";
    say "Backup: $backup";
}
my ($fh, $temp) = tempfile('.daemon.json.XXXXXXXX', DIR => $dir, UNLINK => 1);
print {$fh} $after or die "Cannot write $temp: $!\n";
close $fh or die "Cannot close $temp: $!\n";
rename $temp, $target or die "Cannot replace $target: $!\n";
say "Updated $target; start Docker Desktop to apply it";
