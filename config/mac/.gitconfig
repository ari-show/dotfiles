# ~/.gitconfig (macOS)。bootstrap/setup.pm でシンボリックリンクされる。
[user]
	name = ari-show
	email = rin.zoo.mamiya12345@gmail.com
	# 署名に使う鍵の「公開鍵」。秘密鍵は 1Password の中にだけある。
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHXbWPrM6WBRXWuevvAWnjZmYgw2I7meifKiU3RB8l+o

# コミット署名は 1Password の SSH エージェントで行う。
# 承認は GUI ダイアログ / Touch ID で求められるため TTY が不要で、
# Agent など非対話シェルからの git commit でも詰まらない。
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	# git log --show-signature でローカル検証するための信頼済み署名者リスト
	allowedSignersFile = ~/dotfiles/config/mac/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true

[http]
	postBuffer = 524288000
[core]
	quotepath = false
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
